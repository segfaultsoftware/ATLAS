# Non-secret defaults for the production Compose deployment.
ATLAS_HOST=atlas.home.arpa

# Preferred: a root-owned, mode-0600 file outside the repository.
RAILS_MASTER_KEY_FILE=/srv/platform/secrets/atlas/rails_master_key

# Simpler fallback only: set RAILS_MASTER_KEY in this ignored .env file when
# the host secret file workflow is not available.
