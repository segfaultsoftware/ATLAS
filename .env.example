# Non-secret defaults for the production Compose deployment.
ATLAS_HOST=atlas.home.arpa

# Preferred: a root-owned, mode-0600 file outside the repository.
RAILS_MASTER_KEY_FILE=/srv/platform/secrets/atlas/rails_master_key

# Simpler fallback only: create an ignored raw key file and point Compose to
# it from this ignored .env file. The key still enters the container only as
# a read-only Compose secret.
# RAILS_MASTER_KEY_FILE=./.rails_master_key
