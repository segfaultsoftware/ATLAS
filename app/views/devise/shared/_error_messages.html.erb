<% if resource.errors.any? %>
  <div id="error_explanation" role="alert">
    <h2><%= pluralize(resource.errors.count, "error") %> prevented this account from being saved:</h2>
    <ul>
      <% resource.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
