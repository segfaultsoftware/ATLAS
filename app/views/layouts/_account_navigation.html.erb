<nav class="auth-navigation" aria-label="Account">
  <% if user_signed_in? %>
    <details
      class="account-menu"
      data-controller="account-menu"
      data-action="keydown.esc->account-menu#close focusout->account-menu#closeWhenFocusLeaves toggle->account-menu#syncExpanded"
    >
      <summary
        class="account-menu__button"
        aria-label="Account menu"
        aria-haspopup="menu"
        aria-expanded="false"
        data-account-menu-target="summary"
      >
        <span class="account-menu__avatar" aria-hidden="true"><%= header_avatar_emoji %></span>
      </summary>

      <div class="account-menu__menu" role="menu">
        <%= link_to "View/edit profile", profile_path, role: "menuitem", class: "account-menu__item" %>
        <%= button_to "Log out", logout_path, method: :delete, form: { class: "account-menu__form" }, role: "menuitem", class: "account-menu__item account-menu__item--button" %>
      </div>
    </details>
  <% else %>
    <%= button_to "Login/Register", user_google_oauth2_omniauth_authorize_path, method: :post, class: "auth-navigation__button" %>
  <% end %>
</nav>
