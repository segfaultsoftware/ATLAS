<main class="profile-page">
  <% viewing_current_profile = @profile.user_id == current_user.id %>

  <div class="profile-page__header">
    <h1><%= viewing_current_profile ? "Your profile" : "Profile" %></h1>

    <% if viewing_current_profile %>
      <%= link_to "Edit profile", edit_profile_path, class: "profile-page__action" %>
    <% end %>
  </div>

  <dl class="profile-details">
    <div class="profile-details__field">
      <dt>Preferred name</dt>
      <dd><%= @profile.preferred_name.presence || "Not set" %></dd>
    </div>

    <div class="profile-details__field">
      <dt>Pronouns</dt>
      <dd><%= @profile.pronouns.presence || "Not set" %></dd>
    </div>

    <div class="profile-details__field">
      <dt>Preferred playtimes</dt>
      <dd><%= @profile.preferred_playtimes.presence || "Not set" %></dd>
    </div>

    <div class="profile-details__field">
      <dt>Avatar</dt>
      <dd><%= @profile.avatar_emoji %> <%= @profile.avatar_key.presence || "Not set" %></dd>
    </div>
  </dl>
</main>
