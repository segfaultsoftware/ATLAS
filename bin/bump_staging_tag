#!/usr/bin/env ruby

abort "usage: bin/bump_staging_tag" unless ARGV.empty?

git_auth = ENV.delete("GIT_CONFIG_VALUE_0")
ENV.delete("GIT_CONFIG_COUNT")
ENV.delete("GIT_CONFIG_KEY_0")

require_relative "../lib/atlas/tag_bumper"

Atlas::TagBumper.new(
  tag_ref: Atlas::DeploymentAutomation::STAGING_REF,
  target_label: "staging",
  git_auth:
).run
